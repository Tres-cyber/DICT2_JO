{% extends 'base.twig' %}
{% block head %}
<title>DICT JO - Dashboard</title>
{% endblock %}
{% block header %}
<twig:NavBar />
{% endblock %}
{% block body %}

<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{{ path('app_front') }}">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Create</li>
    </ol>
  </nav>
</div>

<div class="container mx-auto grid place-items-center">
  <div class="card tw-mx-auto tw-w-full tw-max-w-2xl">
    <div class="card-body">
      <h3 class="card-title mb-3">Create job order</h3>

      {{ form_start(form, {'attr': {'novalidate': 'novalidate' }}) }}
      {{ form_errors(form) }}

      <hr>
      <div>
        <h5 class="mb-3">Client Information</h5>

        {{ form_row(form.client_name) }}
        {{ form_row(form.client_lgu) }}
        {{ form_row(form.client_contact) }}
        <div
          class="mb-3"
          data-controller="date-picker"
        >
          <label class="form-label">Request date</label>
          <input type="text" class="form-control" placeholder=" " data-date-picker-target="input">
          <input type="hidden" name="{{ field_name(form.request_date) }}" data-date-picker-target="selected">
        </div>
      </div>

      <hr class="mb-3">

      <div>
        <h5 class="mb-3">Job Order Details</h5>

        <div
          class="mb-3"
          data-controller="date-picker"
          data-date-picker-range-value="true"
          data-date-picker-min-value="{{ date('now') | date('Y-m-d') }}"
        >
          <label class="form-label">Scheduled date</label>
          <input type="text" class="form-control" placeholder=" " data-date-picker-target="input">
          <input type="hidden" name="{{ field_name(form.scheduled_start_date) }}" data-date-picker-target="start">
          <input type="hidden" name="{{ field_name(form.scheduled_end_date) }}" data-date-picker-target="end">
        </div>

        {{ form_errors(form.scheduled_start_date) }}
        {{ form_errors(form.scheduled_end_date) }}
        {{ form_row(form.issuer) }}
        {{ form_row(form.approver) }}
        {{ form_row(form.endorsee) }}
        {{ form_row(form.job_description, {'label_attr': {'class' : 'mt-3' }, 'attr': {'rows': 7 }}) }}
      </div>
      <hr>

      <div>
        <h5>Completion Information</h5>

        <div
          class="mb-3"
          data-controller="date-picker"
          data-date-picker-range-value="true"
          data-date-picker-time-value="true"
        >
          <label class="form-label">Actual date and time done</label>
          <input type="text" class="form-control" placeholder=" " data-date-picker-target="input">
          <input type="hidden" name="{{ field_name(form.start_time) }}" data-date-picker-target="start">
          <input type="hidden" name="{{ field_name(form.end_time) }}" data-date-picker-target="end">
        </div>

        {{ form_row(form.actual_job_done, {'attr': {'rows': 7 }}) }}
        {{ form_row(form.verifier_name) }}
        {{ form_row(form.verifier_position) }}

        {{ form_row(form.remarks, {'label_attr': {'class' : 'mt-3' }, 'attr': {'rows': 7 }}) }}
      </div>

      <div class="row mx-0 gap-2">
        {{ form_widget(form.draft, {'attr': {'class': 'btn btn-primary col-12 col-md' }}) }}

        {% if form.submit is defined %}
          {{ form_widget(form.submit, {'attr': {'class': 'btn btn-success col-12 col-md' }}) }}
        {% endif %}

        {% if form.complete is defined %}
          {{ form_widget(form.complete, {'attr': {'class': 'btn btn-success col-12 col-md' }}) }}
        {% endif %}
      </div>

      {{ form_rest(form) }}

      {{ form_end(form) }}
    </div>
  </div>
</div>

{% endblock %}
