{% extends 'base.twig' %}
{% block head %}
<title>ADMIN | Projects</title>
{% endblock %}
{% block header %}
{% include 'nav-bar.twig' %}
{% endblock %}
{% block body %}

<div class="container mt-4 mt-sm-5">
  <div class="row align-items-center justify-content-between gap-2">
    <em class="col-12 col-lg-auto">
      {% if projects.totalItemCount > 0 %}
        Showing {{ projects.customParameters.startIndex }} - {{ projects.customParameters.endIndex }} of
        {{ projects.totalItemCount }} results
      {% else %}
        Nothing Found.
      {% endif %}
    </em>
    <div class="d-flex justify-content-start align-items-center col-12 col-lg-auto gap-2">
      <button
        class="btn btn-sm btn-success d-flex align-items-center gap-1"
        data-bs-toggle="modal"
        data-bs-target="#add-modal"
      >
        <span class="no-wrap tw-hidden sm:tw-block">Add project</span>
        <i class="fa-solid fa-plus"></i>
      </button>
      <form hx-target="body" hx-get="{{ path('projects_index') }}" hx-push-url="true" class="input-group">
        <input
          class="form-control form-control-sm"
          type="text"
          name="search"
          placeholder="Search..."
          value="{{ search }}"
        >
        <button
          type="submit"
          class="btn btn-sm btn-primary"
        >
          Search
        </button>
      </form>
      <a
        hx-boost="true"
        href="{{ path(app.request.attributes.get('_route')) }}"
        class="btn btn-sm btn-secondary d-flex align-items-center gap-1"
      >
        <span class="hidden sm:block">Clear</span>
        <i class="fa-solid fa-broom"></i>
      </a>
    </div>
  </div>

  <div class="col table-responsive mx-auto mt-3">
    <table class="table-light table-hover table-striped table border">
      <thead>
        <tr>
          <th>Short Code</th>
          <th>Project Name</th>
          <th>Icon</th>
          <th>Focal Person</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody class="table-group-divider">
        {% for proj in projects %}
          <tr>
            <td data-label="Short Code">{{ proj.code }}</td>
            <td data-label="Project Name">{{ proj.name }}</td>
            <td data-label="Icon">
              {% if proj.logo is not empty %}
                <img class="td-icon tw-h-6" src="{{ proj.logo }}" alt="icon">
              {% else %}
                <img class="td-icon tw-h-6" src="/storage/default.png" alt="icon">
              {% endif %}
            </td>
            <td data-label="Focal Person">{{ proj.focalPerson.name }}</td>
            <td data-label="Action">
              <div class="d-flex flex-no-wrap gap-1">
                <a
                  href="#"
                  class="btn btn-sm btn-primary"
                  data-bs-toggle="modal"
                  data-bs-target="#edit-modal"
                  onclick="setProjectId({{ proj.id }}, '{{ proj.name }}', '{{ proj.code }}', '{{ proj.name }}', '{{ proj.logo }}')"
                >
                  <i class="fa-solid fa-pen tw-h-3 tw-w-3"></i>
                </a>
                <button
                  class="btn btn-sm btn-primary"
                  data-bs-toggle="modal"
                  data-bs-target="#edit-modal"
                  hx-get="{{ path('personnel_edit', {id: proj.id }) }}"
                  hx-target="#edit-form"
                  hx-indicator="#edit-loading"
                  hx-swap="outerHTML"
                >
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button
                  class="btn btn-sm btn-danger"
                  data-bs-toggle="modal"
                  data-bs-target="#delete-modal"
                  hx-delete="{{ path('project_delete', {id: proj.id}) }}"
                  hx-target="body"
                  hx-trigger="confirmed"
                  hx-push-url="true"
                  x-data
                  @click="$dispatch('confirm')"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="999" class="!text-left">
              <em>No projects found.</em>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="container mt-3" hx-boost="true">
  {{ knp_pagination_render(projects) }}
</div>

{% endblock %}
{% block outside %}
<div
  class="modal fade"
  id="delete-modal"
  tabindex="-1"
  aria-labelledby="delete-label"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="delete-label">Confirm Deletion</h5>
      </div>
      <div class="modal-body">Are you sure you want to delete this personnel?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button
          class="btn btn-danger"
          data-bs-dismiss="modal"
          x-data="{ target: null }"
          @confirm.window="target = $event.target; console.log($event.target)"
          @click="htmx.trigger(target, 'confirmed')"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="edit-modal"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  tabindex="-1"
  aria-labelledby="staticBackdropLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="staticBackdropLabel">Edit Project</h1>
        <div class="spinner-border spinner-border-sm ms-3 htmx-indicator" role="status" id="edit-loading">
          <span class="visually-hidden">Loading...</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="edit-form" class="placeholder-glow">
          <div class="placeholder col-4"></div>
          <div class="placeholder placeholder-lg col-12 mb-3"></div>
          <div class="placeholder col-5"></div>
          <div class="placeholder placeholder-lg col-12 mb-3"></div>
          <div class="placeholder col-4"></div>
          <div class="placeholder placeholder-lg col-12 mb-3"></div>
          <div class="btn btn-primary disabled placeholder col-4"></div>
        </form>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="add-modal"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  tabindex="-1"
  aria-labelledby="staticBackdropLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="staticBackdropLabel">Add Project</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form hx-post="{{ path('projects_index') }}" hx-target="body" hx-push-url="true" enctype="multipart/form-data">
          {{ form_rest(addForm) }}
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}
