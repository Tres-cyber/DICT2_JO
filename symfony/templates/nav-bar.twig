{% set route = app.request.attributes.get('_route') %}

<nav
  class="navbar navbar-expand-md"
  style="background-color: {{ app.user.admin ? '#eb4c39' : '#3f5e8c'}}"
  data-bs-theme="dark"
>
  <div class="container">
    <a class="navbar-brand" href="{{ path('app_front') }}" hx-boost="true">
      <img src="/assets/logo.png" alt="Logo" class="d-inline-block align-text-center rounded-circle tw-h-14 tw-w-14">
      DICT
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0" hx-boost="true">
        {% if app.user.admin %}
          <li class="nav-item">
            <a
              class="nav-link{% if route == 'admin_joborders' %} active{%endif%}"
              href="{{ path('admin_joborders') }}"
              >Job Orders</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link{% if route == 'activities_index' %} active{%endif%}"
              href="{{ path('activities_index') }}"
              >Activities</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link{% if route == 'accounts_index' %} active{%endif%}" href="{{ path('accounts_index') }}"
              >Accounts</a
            >
          </li>
          <li class="nav-item">
            <a class="nav-link{% if route == 'projects_index' %} active{%endif%}" href="{{ path('projects_index') }}"
              >Projects</a
            >
          </li>
          <li class="nav-item mr-5">
            <a
              class="nav-link{% if route == 'personnels_index' %} active{%endif%}"
              href="{{ path('personnels_index') }}"
              >Personnels</a
            >
          </li>
        {% else %}
          <li class="nav-item">
            <a class="nav-link{% if route == 'user_dashboard' %} active{% endif %}" href="{{ path('user_dashboard') }}"
              >Dashboards</a
            >
          </li>
        {% endif %}
      </ul>
      <div class="d-flex">
        <a hx-boost="true" href="{{ path('app_logout') }}" class="btn btn-secondary align-self-center">Logout</a>
      </div>
    </div>
  </div>
</nav>
