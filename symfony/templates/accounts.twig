{% extends 'base.twig' %}
{% block head %}
<title>ADMIN | Accounts</title>
{% endblock %}
{% block header %}
{% include 'nav-bar.twig' %}
{% endblock %}
{% block body %}

<div class="container mt-4 mt-sm-5">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Home</li>
    </ol>
  </nav>

  <div class="row align-items-center justify-content-between gap-2">
    <em class="col-12 col-lg-auto">
      {% if accounts.totalItemCount > 0 %}
        Showing {{ accounts.customParameters.startIndex }} - {{ accounts.customParameters.endIndex }} of
        {{ accounts.totalItemCount }} results
      {% else %}
        Nothing Found.
      {% endif %}
    </em>
    <div class="d-flex justify-content-start align-items-center col-12 col-lg-auto gap-2">
      <button
        class="btn btn-sm btn-success d-flex align-items-center gap-1"
        data-bs-toggle="modal"
        data-bs-target="#add-modal"
      >
        <span class="no-wrap tw-hidden sm:tw-block">Add account</span>
        <i class="fa-solid fa-plus"></i>
      </button>
      <form hx-target="body" hx-get="{{ path('accounts_index') }}" hx-push-url="true" class="input-group">
        <input
          class="form-control form-control-sm"
          type="text"
          name="search"
          placeholder="Search..."
          value="{{ search }}"
        >
        <button
          type="submit"
          class="btn btn-sm btn-primary"
        >
          Search
        </button>
      </form>
      <a
        hx-boost="true"
        href="{{ path(app.request.attributes.get('_route')) }}"
        class="btn btn-sm btn-secondary d-flex align-items-center gap-1"
      >
        <span class="hidden sm:block">Clear</span>
        <i class="fa-solid fa-broom"></i>
      </a>
    </div>
  </div>

  <div class="col col-lg-9 col-xl-8 col-xxl-7 mx-auto mt-3">
    <table class="table-light table-striped table border table-stack table-stack-md">
      <thead>
        <tr>
          <th>Account Name</th>
          <th>Session Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody
        class="table-group-divider"
        hx-get="{{ path('accounts_index', {table: true, page: page, search: search}) }}"
        hx-trigger="every 5s"
      >
        {% include 'accounts-table.twig' %}
      </tbody>
    </table>
  </div>
</div>

<div class="container mt-3" hx-boost="true">
  {{ knp_pagination_render(accounts) }}
</div>

{% endblock %}
{% block outside %}
<div
  class="modal fade"
  id="delete-modal"
  tabindex="-1"
  aria-labelledby="delete-label"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="delete-label">Confirm Deletion</h5>
      </div>
      <div class="modal-body">Are you sure you want to delete this personnel?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button
          class="btn btn-danger"
          data-bs-dismiss="modal"
          x-data="{ target: null }"
          @confirm.window="target = $event.target"
          @click="htmx.trigger(target, 'confirmed')"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</div>

<div
  class="modal fade"
  id="add-modal"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
  tabindex="-1"
  aria-labelledby="add-label"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="add-label">Add Account</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form hx-post="{{ path('accounts_index') }}" hx-target="body" hx-push-url="true">
          {{ form_rest(addForm) }}
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
