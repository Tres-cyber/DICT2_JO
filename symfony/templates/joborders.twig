{% extends 'base.twig' %}
{% block head %}
<title>DICT JO - Dashboard</title>
{% endblock %}
{% block header %}
{% include 'nav-bar.twig' %}
{% endblock %}
{% block body %}
<div class="container mt-4 mt-sm-5">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item active" aria-current="page">Home</li>
    </ol>
  </nav>

  <div class="row align-items-center justify-content-between gap-2">
    <em class="col-12 col-md-auto">
      {% if jobOrders.totalItemCount > 0 %}
        Showing page {{ jobOrders.currentPageNumber }} of {{ jobOrders.totalItemCount }}
      {% else %}
        Nothing Found.
      {% endif %}
    </em>
    <div class="d-flex justify-content-start align-items-center col-12 col-md-auto gap-2">
      {% if isAdmin %}
        <div class="btn-group">
          <button
            class="btn btn-sm btn-primary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            data-bs-auto-close="outside"
            aria-expanded="false"
          >
            Create new
          </button>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Menu item</a></li>
            <li><a class="dropdown-item" href="#">Menu item</a></li>
            <li><a class="dropdown-item" href="#">Menu item</a></li>
          </ul>
        </div>
      {% else %}
        <a
          href="/form.php"
          class="btn btn-sm btn-primary d-flex align-items-center gap-1"
        >
          <span class="hidden sm:block">Add</span>
          <i class="fa-solid fa-plus"></i>
        </a>
      {% endif %}
      <form action="{{ path(app.request.attributes.get('_route')) }}" method="GET" class="input-group">
        <input class="form-control form-control-sm" type="text" name="search" placeholder="Search...">
        <button
          type="submit"
          class="btn btn-sm btn-success"
        >
          Search
        </button>
      </form>
      <a
        href="{{ path(app.request.attributes.get('_route')) }}"
        class="btn btn-sm btn-secondary d-flex align-items-center gap-1"
      >
        <span class="hidden sm:block">Clear</span>
        <i class="fa-solid fa-broom"></i>
      </a>
    </div>
  </div>
</div>

<div class="container mt-3">
  <table class="table-light table-striped table border table-stack table-stack-xl">
    <thead>
      <tr>
        <th>Job Order Number</th>
        {% if isAdmin %}
          <th>Performed By</th>
        {% endif %}
        <th>Name</th>
        <th>Date</th>
        <th>Scheduled Date</th>
        <th>Issued By</th>
        <th>Approved By</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      {% for jo in jobOrders %}
        <tr>
          <td data-class="Job Order Number">{{ jo.job_order_number }}</td>
          {% if isAdmin %}
            <td>{{ jo.performer.name }}</td>
          {% endif %}
          <td data-class="Name">{{ jo.client_name }}</td>
          <td data-class="Date">{{ jo.request_date | date("M d, Y") }}</td>
          <td data-class="Scheduled Date">
            {{ jo.scheduled_start_date | date("M d, Y") }}-{{ jo.scheduled_end_date | date("M d, Y") }}
          </td>
          <td data-class="Issued By">{{ jo.issued_by }}</td>
          <td data-class="Approved By">{{ jo.approved_by }}</td>
          <td data-class="Status">{{ jo.status }}</td>
          <td data-class="Actions">
            <div class="d-flex flex-no-wrap gap-1">
              {% if jo.status == 'Draft' %}
                <a href="/form.php?edit={{ jo.job_order_id}}" class="btn btn-sm btn-primary">
                  <i class="fa-solid fa-pen"></i>
                </a>
              {% else %}
                <a href="/form.php?id={{ jo.job_order_id}}" class="btn btn-sm btn-success">
                  <i class="fa-solid fa-eye"></i>
                </a>
              {% endif %}
              <a href="/form.php?delete={{ jo.job_order_id}}" class="btn btn-sm btn-danger">
                <i class="fa-solid fa-trash"></i>
              </a>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="999" class="!text-left">
            <em>No job orders found.</em>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="container" hx-boost="true">
  {{ knp_pagination_render(jobOrders) }}
</div>
{% endblock %}
