{% for acc in accounts %}
  <tr>
    <td data-label="Account Name">
      {{ acc.personnel ? acc.personnel.name : 'admin' }}
    </td>
    <td
      data-label="Session Status"
    >
      {% if acc.hasSession() %}
        <span class="text-success">active</span>
      {% else %}
        <span class="text-success">offline</span>
      {% endif %}
    </td>
    <td data-label="Action">
      <div class="d-flex flex-no-wrap gap-1">
        <button
          hx-get="{{ path('account_logout', {id: acc.id}) }}"
          hx-target="body"
          hx-push-url="true"
          class="btn btn-sm btn-primary"
        >
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
        <button class="btn btn-sm btn-secondary">
          <i class="fa-solid fa-rotate-right"></i>
        </button>
        <button
          @click="$dispatch('confirm')"
          class="btn btn-sm btn-danger"
          data-bs-target="#delete-modal"
          data-bs-title="Delete account"
          data-bs-toggle="modal"
          hx-delete="{{ path('account_delete', {id: acc.id}) }}"
          hx-push-url="true"
          hx-target="body"
          hx-trigger="confirmed"
          x-data="tooltip"
        >
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </td>
  </tr>
{% endfor %}
